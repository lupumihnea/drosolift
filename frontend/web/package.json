    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
